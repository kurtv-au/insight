# MySQL connection string (matches docker-compose.yml for local development)
NUXT_DATABASE_URL=mysql://insight:insight@localhost:3306/insight

# Secret used to seal session cookies (at least 32 characters)
NUXT_SESSION_PASSWORD=replace-with-a-random-string-of-at-least-32-characters

# Public URL of the app, used in email links
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Email: 'ses' sends through AWS SES, 'console' logs emails to the server console
NUXT_EMAIL_TRANSPORT=console
NUXT_EMAIL_FROM="Insight <no-reply@answerunited.com>"

# AWS SES region. Credentials come from the standard AWS provider chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, AWS_PROFILE, or an IAM role).
NUXT_AWS_REGION=us-east-1

# Address that receives messages from the /support form (replies go to the sender)
NUXT_SUPPORT_EMAIL=custserv@answerunited.com
